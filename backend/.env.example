# ======================================
# AquaMoab - Configuração de Ambiente
# ======================================

# ---- Banco de Dados (Neon PostgreSQL) ----
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx.us-east-2.aws.neon.tech/aquamoab?sslmode=require

# ---- Redis (Celery Broker) ----
REDIS_URL=redis://localhost:6379/0

# ---- JWT Auth ----
JWT_SECRET=sua-chave-secreta-aqui-mude-em-producao
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- Banco Inter (Cobrança V3) ----
INTER_CLIENT_ID=seu-client-id
INTER_CLIENT_SECRET=seu-client-secret
INTER_CERT_PATH=./certs/inter_cert.crt
INTER_KEY_PATH=./certs/inter_key.key
INTER_SANDBOX=true
INTER_CONTA_CORRENTE=123456789

# ---- WhatsApp Cloud API ----
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=seu-token-aqui
WHATSAPP_PHONE_ID=seu-phone-id-aqui
WHATSAPP_API_VERSION=v17.0

# ---- Kimi K2.6 (Moonshot AI) ----
KIMI_API_KEY=sua-api-key-moonshot-aqui

# ---- Upload de Arquivos ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ---- Aplicação ----
APP_NAME=AquaMoab
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DEBUG=true
