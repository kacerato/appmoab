# ======================================
# AquaMoab - Configuração de Ambiente
# ======================================

# ---- Banco de Dados (Neon PostgreSQL) ----
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx.us-east-2.aws.neon.tech/aquamoab?sslmode=require
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30

# ---- Redis (Celery Broker) ----
REDIS_URL=redis://localhost:6379/0

# ---- JWT Auth ----
# Compatível também com SECRET_KEY para ambientes antigos.
JWT_SECRET=sua-chave-secreta-aqui-mude-em-producao
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- Efí Pay (Cobranças / Bolix) ----
EFI_CLIENT_ID=seu-client-id
EFI_CLIENT_SECRET=seu-client-secret
EFI_SANDBOX=true
EFI_NOTIFICATION_URL=https://seu-backend.com/api/webhooks/efi
EFI_BOLETO_DAYS_TO_WRITE_OFF=30

# Producao real: EFI_SANDBOX=false e use o certificado de producao da aplicacao.
# Nunca commite certificados. Monte/adicione o arquivo no ambiente e aponte o caminho.
EFI_P12_BASE64=
EFI_P12_PATH=
EFI_P12_PASSWORD=

# Alternativa ao .p12: use apenas se converter para par PEM.
EFI_CERT_PATH=
EFI_KEY_PATH=

# ---- WhatsApp / Evolution API ----
# Em Docker Compose local, use o hostname do serviço: http://evolution-api:8080
# Em Railway, troque para a URL interna/privada real do serviço Evolution.
WHATSAPP_ENABLED=false
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=troque-por-uma-chave-forte
EVOLUTION_INSTANCE_NAME=appmoab

# ---- Legacy WhatsApp Cloud API (opcional/ignorado ao usar Evolution) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v17.0

# ---- GLM-OCR (Z.AI) ----
# Legado/modo sombra; nao decide a leitura quando VISION_GLM_SHADOW_ENABLED=false.
GLM_API_KEY=sua-chave-glm-aqui

# ---- Visao computacional especializada ----
VISION_ENABLED=true
# Caminho de um classificador ONNX ou OpenCV KNN .yml promovido pelo treinador.
VISION_MODEL_PATH=
VISION_DETECTOR_MODEL_PATH=
VISION_TRANSITION_MODEL_PATH=
VISION_CALIBRATION_PATH=
VISION_MODEL_VERSION=meter-field-v3-20260622
VISION_MIN_AUTOFILL_CONFIDENCE=0.985
VISION_GLM_SHADOW_ENABLED=false
VISION_STORE_DEBUG_ARTIFACTS=true

# ---- Upload de Arquivos ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
PUBLIC_UPLOAD_BASE_URL=

# ---- Storage externo opcional: Cloudflare R2 ----
# Deixe STORAGE_BACKEND=local enquanto nao criar bucket/chaves no Cloudflare.
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_PRESIGNED_URL_EXPIRE_SECONDS=900

# ---- Performance e protecao de API ----
PERFORMANCE_LOG_SLOW_MS=800
API_PRIVATE_CACHE_SECONDS=20
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MUTATION_REQUESTS=90
RATE_LIMIT_LOGIN_REQUESTS=12
WEBHOOK_SHARED_SECRET=

# ---- Aplicação ----
APP_NAME=AquaMoab
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DEBUG=true
